{
  "manifest_version": 3,
  "name": "Tactab — Browser MCP Bridge",
  "version": "1.0.0",
  "description": "Tactile DOM interaction and multimodal visual bridge for AI agents via Model Context Protocol (MCP).",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tactab — Browser MCP Bridge"
  }
}
